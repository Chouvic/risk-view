{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve API",
      "type": "shell",
      "command": "uv run uvicorn riskview.main:app --reload --port 8000",
      "dependsOn": ["Free API port"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Serve UI",
      "type": "shell",
      "command": "npm run dev --prefix frontend",
      "dependsOn": ["Free UI port"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Serve API + UI",
      "dependsOn": ["Serve API", "Serve UI"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Sample report",
      "type": "shell",
      "command": "uv run python scripts/fund_report.py --data samples/cashflows.csv",
      "problemMatcher": []
    },
    {
      "label": "Free API port",
      "type": "shell",
      "command": "./scripts/free-port.sh 8000",
      "windows": { "command": "scripts\\free-port.cmd 8000" },
      "presentation": { "reveal": "silent", "panel": "shared", "close": true },
      "problemMatcher": []
    },
    {
      "label": "Free UI port",
      "type": "shell",
      "command": "./scripts/free-port.sh 5173",
      "windows": { "command": "scripts\\free-port.cmd 5173" },
      "presentation": { "reveal": "silent", "panel": "shared", "close": true },
      "problemMatcher": []
    }
  ]
}
